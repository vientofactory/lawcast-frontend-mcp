{
  "name": "lawcast-frontend-mcp",
  "version": "0.1.2",
  "description": "Source-backed LawCast design system and Svelte UI guardrails over MCP",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lawcast-frontend-mcp": "src/server.js",
    "lawcast-design-check": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "snapshot": "node scripts/snapshot.js",
    "check": "node src/cli.js",
    "test": "node --test dist/test/*.test.js",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "postcss": "^8.5.6",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
